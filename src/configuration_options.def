/*
 * Primitive configuration options.
 *
 * This file intentionally has no include guard.  Its includer must define all
 * XX_* macros below before including it.
 */

XX_DIR(ncmpcpp_directory, "~/.config/ncmpcpp/")
XX_DIR(lyrics_directory, "~/.lyrics/")

XX_PATH(mpd_host, "localhost")
XX_INT_RANGE(mpd_port, "6600", INT32_MIN, INT32_MAX)
XX_STRING(mpd_password, "")
XX_DIR(mpd_music_dir, "~/music")
XX_INT_RANGE(mpd_connection_timeout, "5", INT32_MIN, INT32_MAX)
XX_INT_RANGE(mpd_crossfade_time, "5", INT32_MIN, INT32_MAX)

XX_STRING(random_exclude_pattern, "")
XX_PATH(visualizer_data_source, "/tmp/mpd.fifo")
XX_STRING(visualizer_output_name, "Visualizer feed")
XX_BOOL(visualizer_in_stereo, "yes")
XX_INT_RANGE(visualizer_fps, "60", 30, 1000)
XX_BOOL(visualizer_autoscale, "no")
XX_BOOL(visualizer_spectrum_smooth_look, "yes")
XX_BOOL(visualizer_spectrum_smooth_look_legacy_chars, "yes")
XX_INT_RANGE(visualizer_spectrum_dft_size, "2", 1, 5)
XX_DOUBLE_RANGE(visualizer_spectrum_gain, "10", 0, 100)
XX_DOUBLE_RANGE(visualizer_spectrum_hz_min, "20", 1, INFINITY)
XX_DOUBLE_RANGE(visualizer_spectrum_hz_max, "20000",
                config->visualizer_spectrum_hz_min + 1, INFINITY)
XX_BOOL(visualizer_spectrum_log_scale_x, "yes")
XX_BOOL(visualizer_spectrum_log_scale_y, "yes")
XX_STRING(system_encoding, "")
XX_INT_RANGE(playlist_disable_highlight_delay, "5", INT32_MIN, INT32_MAX)
XX_INT_RANGE(message_delay_time, "5", INT32_MIN, INT32_MAX)

XX_PATH(execute_on_song_change, "")
XX_PATH(execute_on_player_state_change, "")
XX_BOOL(playlist_show_mpd_host, "no")
XX_BOOL(playlist_show_remaining_time, "no")
XX_BOOL(playlist_shorten_total_times, "no")
XX_BOOL(playlist_separate_albums, "no")
XX_BOOL(discard_colors_if_item_is_selected, "yes")
XX_BOOL(show_duplicate_tags, "yes")
XX_BOOL(incremental_seeking, "yes")
XX_INT_RANGE(seek_time, "1", INT32_MIN, INT32_MAX)
XX_INT_RANGE(volume_change_step, "2", INT32_MIN, INT32_MAX)
XX_BOOL(autocenter_mode, "no")
XX_BOOL(centered_cursor, "no")
XX_BOOL(data_fetching_delay, "yes")
XX_BOOL(media_library_hide_album_dates, "no")
XX_BOOL(media_library_albums_split_by_date, "yes")
XX_STRING(default_tag_editor_pattern, "%n - %t")
XX_BOOL(header_visibility, "yes")
XX_BOOL(statusbar_visibility, "yes")
XX_BOOL(connected_message_on_startup, "yes")
XX_BOOL(titles_visibility, "yes")
XX_BOOL(header_text_scrolling, "yes")
XX_BOOL(cyclic_scrolling, "no")
XX_BOOL(follow_now_playing_lyrics, "no")
XX_BOOL(fetch_lyrics_for_current_song_in_background, "no")
XX_BOOL(store_lyrics_in_song_dir, "no")
XX_BOOL(generate_win32_compatible_filenames, "yes")
XX_BOOL(allow_for_physical_item_deletion, "no")
XX_STRING(lastfm_preferred_language, "en")
XX_BOOL(show_hidden_files_in_local_browser, "no")
XX_BOOL(startup_slave_screen_focus, "no")
XX_DOUBLE_RANGE(locked_screen_width_part, "50", -INFINITY, INFINITY)
XX_BOOL(ask_for_locked_screen_width_part, "yes")
XX_BOOL(jump_to_now_playing_song_at_start, "yes")
XX_BOOL(ask_before_clearing_playlists, "yes")
XX_BOOL(ask_before_shuffling_playlists, "yes")
XX_BOOL(display_volume_level, "yes")
XX_BOOL(display_bitrate, "no")
XX_BOOL(display_remaining_time, "no")
XX_BOOL(ignore_leading_the, "no")
XX_BOOL(block_search_constraints_change_if_items_found, "yes")
XX_BOOL(mouse_support, "yes")
XX_BOOL(mouse_list_scroll_whole_page, "no")
XX_INT_RANGE(lines_scrolled, "5", INT32_MIN, INT32_MAX)
XX_STRING(empty_tag_marker, "<empty>")
XX_STRING(tags_separator, " | ")
XX_BOOL(tag_editor_extended_numeration, "no")
XX_BOOL(media_library_sort_by_mtime, "no")
XX_BOOL(enable_window_title, "yes")
XX_INT_RANGE(search_engine_default_search_mode, "1", 1, 3)
XX_PATH(external_editor, "nano")
XX_BOOL(use_console_editor, "yes")
XX_BOOL(colors_enabled, "yes")
